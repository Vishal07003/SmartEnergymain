# Django Core Settings
DEBUG=True
SECRET_KEY=your-secure-secret-key-placeholder-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL Database Configuration
DB_NAME=smart_energy_db
DB_USER=smart_energy_user
DB_PASSWORD=your_secure_db_password_placeholder
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration (Web dashboards / browser clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# Redis Channel Layer (Prepared for real-time WebSocket)
REDIS_URL=redis://127.0.0.1:6379/1
USE_REDIS_CHANNEL_LAYER=False

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
